# /etc/pzbot/env -- the small set of things the bot cannot discover for itself.
#
# Everything else comes from Parameter Store under /pz/<stack>/ (secrets, Discord ids,
# the idle knobs) or from the game server's own tags (its instance id, its private IP).
# install.sh writes this file; it is listed here so you can see what is in it.

# Which stack, and where. install.sh reads both from the bot host's own IMDS.
PZBOT_STACK=prod
PZBOT_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# What players paste into the Project Zomboid client. This is the one value that is
# neither in Parameter Store nor derivable from a tag -- it is a DNS name owned by the
# pzserver stack (`terraform output connect_string`).
PZBOT_CONNECT_HOST=pz.joncfrancis.co
PZBOT_CONNECT_PORT=16261

# RCON. The port is fixed by pzserver's security group; the host is discovered from the
# game server's private IP on every probe, so it is not set here.
PZBOT_RCON_PORT=27015

# INFO, or DEBUG when something is wrong. DEBUG is loud.
PZBOT_LOG_LEVEL=INFO
